{
  "name": "night-library-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "wrangler pages dev dist --ip 127.0.0.1",
    "deploy": "node scripts/verify-config.mjs && npm run check && npm run build && wrangler d1 migrations apply DB --remote && wrangler pages deploy dist",
    "db:create": "wrangler d1 create night-library-db",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "configure": "node scripts/configure.mjs"
  },
  "dependencies": {
    "jose": "6.1.3",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.27.4",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
